<mxfile host="drawio" version="31.5.3"><diagram id="detail" name="PrimAttack detailed architecture"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="frame" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry" /></mxCell><mxCell id="title" value="PrimAttack from train calibration to nested ASR" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="42" as="geometry" /></mxCell><mxCell id="g0" value="Offline, TRAIN split only" style="rounded=0;whiteSpace=wrap;html=1;container=1;pointerEvents=0;collapsible=0;fillColor=#f4f4f4;strokeColor=#9a9a9a;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=20;fontStyle=1;fontColor=#333333;gradientColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="300" height="1000" as="geometry" /></mxCell><mxCell id="g1" value="Per-cell setup on the TEST split" style="rounded=0;whiteSpace=wrap;html=1;container=1;pointerEvents=0;collapsible=0;fillColor=#f4f4f4;strokeColor=#9a9a9a;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=20;fontStyle=1;fontColor=#333333;gradientColor=none;" vertex="1" parent="1"><mxGeometry x="345" y="60" width="340" height="1000" as="geometry" /></mxCell><mxCell id="g2" value="RealizedSearch per flow, B = 256 evals" style="rounded=0;whiteSpace=wrap;html=1;container=1;pointerEvents=0;collapsible=0;fillColor=#f4f4f4;strokeColor=#9a9a9a;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=20;fontStyle=1;fontColor=#333333;gradientColor=none;" vertex="1" parent="1"><mxGeometry x="735" y="60" width="815" height="1000" as="geometry" /></mxCell><mxCell id="g3" value="Post-attack evaluation" style="rounded=0;whiteSpace=wrap;html=1;container=1;pointerEvents=0;collapsible=0;fillColor=#f4f4f4;strokeColor=#9a9a9a;strokeWidth=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=20;fontStyle=1;fontColor=#333333;gradientColor=none;" vertex="1" parent="1"><mxGeometry x="1575" y="60" width="325" height="1000" as="geometry" /></mxCell><mxCell id="d_train" value="&lt;b&gt;TRAIN split&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;X_train_pristine.npy&lt;br&gt;y_train_cat.npy&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="g0"><mxGeometry x="15" y="180" width="270" height="90" as="geometry" /></mxCell><mxCell id="d_calib" value="&lt;b&gt;Budget calibration&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;primattack_budget.py&lt;br&gt;p_max ← class quantile of&lt;br&gt;positive FwdLenMean&lt;br&gt;r_max ← class quantile of&lt;br&gt;|Dur − median| / median&lt;br&gt;FINAL p50, p75, unbounded&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="g0"><mxGeometry x="15" y="310" width="270" height="180" as="geometry" /></mxCell><mxCell id="d_art" value="&lt;b&gt;Calibration artifact&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;budget_calibration.json&lt;br&gt;per-class p_max, r_max&lt;br&gt;global p99 envelope on 8&lt;br&gt;fwd feats + Flow Duration&lt;br&gt;class p05 Flow Packets/s&lt;br&gt;(DoS/DDoS rate floor)&lt;br&gt;p99 Flow Duration&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="g0"><mxGeometry x="15" y="540" width="270" height="210" as="geometry" /></mxCell><mxCell id="d_test" value="&lt;b&gt;TEST split, pristine&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;raw source flows x&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="g1"><mxGeometry x="15" y="50" width="310" height="90" as="geometry" /></mxCell><mxCell id="d_sel" value="&lt;b&gt;Frozen selection&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;800 clean-correct flows&lt;br&gt;per victim × class, seed 42&lt;br&gt;SHA-256 and index checks&lt;br&gt;re-predicted, must be correct&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="g1"><mxGeometry x="15" y="180" width="310" height="130" as="geometry" /></mxCell><mxCell id="d_cap" value="&lt;b&gt;Capability inference&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;pad_allowed = N&lt;sub&gt;f&lt;/sub&gt; ≥ 1 ∧&lt;br&gt;TotLenFwd &amp;gt; 0 ∧ FwdLenMin &amp;gt; 0&lt;br&gt;∧ FwdLenMean &amp;gt; 0&lt;br&gt;timing_allowed = N&lt;sub&gt;f&lt;/sub&gt; ≥ 2 ∧&lt;br&gt;Fwd IAT Total &amp;gt; 0&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="g1"><mxGeometry x="15" y="350" width="310" height="150" as="geometry" /></mxCell><mxCell id="d_box" value="&lt;b&gt;Per-flow hard box&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;p&lt;sup&gt;hi&lt;/sup&gt; = pad_allowed · clip to&lt;br&gt;[0, p_max] of min headroom&lt;br&gt;D&lt;sup&gt;hi&lt;/sup&gt; = timing_allowed · min(&lt;br&gt;r_max·Duration, envelope,&lt;br&gt;Fwd IAT Max/Std at worst s,&lt;br&gt;DoS/DDoS rate floor)&lt;br&gt;s&lt;sup&gt;hi&lt;/sup&gt; = timing_allowed ∈ {0,1}&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="g1"><mxGeometry x="15" y="540" width="310" height="210" as="geometry" /></mxCell><mxCell id="d_mode" value="&lt;b&gt;Primitive mode per row&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;joint, timing-only,&lt;br&gt;padding-only or no-primitive&lt;br&gt;&amp;lt; 1 integer unit headroom&lt;br&gt;⇒ control pinned at 0&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="g1"><mxGeometry x="15" y="790" width="310" height="130" as="geometry" /></mxCell><mxCell id="d_sur" value="&lt;b&gt;Gradient-only surrogate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;φ quantize=False, max(q, 1e-3)&lt;br&gt;straight-through ∇, pinned cut&lt;br&gt;1 eval + 1 realized = 2/step&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#808080;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="g2"><mxGeometry x="20" y="50" width="330" height="110" as="geometry" /></mxCell><mxCell id="d_step" value="&lt;b&gt;Optimizer step, q ∈ [0,1]³&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;p = q&lt;sub&gt;1&lt;/sub&gt;·p&lt;sup&gt;hi&lt;/sup&gt;, D = q&lt;sub&gt;2&lt;/sub&gt;·D&lt;sup&gt;hi&lt;/sup&gt;,&lt;br&gt;s = q&lt;sub&gt;3&lt;/sub&gt;·s&lt;sup&gt;hi&lt;/sup&gt;&lt;br&gt;sign-momentum or Adam&lt;br&gt;pinned coordinates masked&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="g2"><mxGeometry x="20" y="210" width="330" height="150" as="geometry" /></mxCell><mxCell id="d_proj" value="&lt;b&gt;Integer projection&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;p, D rounded to bytes / µs&lt;br&gt;≤ ⌊p&lt;sup&gt;hi&lt;/sup&gt;⌋, ⌊D&lt;sup&gt;hi&lt;/sup&gt;⌋; s clamped&lt;br&gt;disallowed → 0; s = 0 if D = 0&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="g2"><mxGeometry x="20" y="400" width="330" height="110" as="geometry" /></mxCell><mxCell id="d_phi" value="&lt;b&gt;Canonical transform φ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;φ(x; p, D, s), quantize=True&lt;br&gt;padding block if p &amp;gt; 0&lt;br&gt;timing block if D &amp;gt; 0&lt;br&gt;a = 1 + (1−s)D/FIT0, b = sD/g&lt;br&gt;integers rounded, then means,&lt;br&gt;std and rates recomputed&lt;br&gt;writes only 23-feature support&lt;br&gt;LEVEL_C constant; p=D=0 ⇒ x′=x&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#d6e4f5;strokeColor=#1f5fa8;strokeWidth=2.5;" vertex="1" parent="g2"><mxGeometry x="20" y="550" width="330" height="220" as="geometry" /></mxCell><mxCell id="d_pred" value="&lt;b&gt;Victim f, frozen, white-box&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;logits z on (x′ − median)/IQR&lt;br&gt;targeted max&lt;sub&gt;j≠0&lt;/sub&gt; z&lt;sub&gt;j&lt;/sub&gt; − z&lt;sub&gt;0&lt;/sub&gt;&lt;br&gt;untargeted z&lt;sub&gt;y&lt;/sub&gt; − max&lt;sub&gt;j≠y&lt;/sub&gt; z&lt;sub&gt;j&lt;/sub&gt;&lt;br&gt;hit when margin &amp;lt; 0&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="g2"><mxGeometry x="20" y="820" width="330" height="140" as="geometry" /></mxCell><mxCell id="d_opts" value="&lt;b&gt;Three optimizers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;Hybrid T = 40, η0 = 0.1&lt;br&gt;Prim-PGD 3×42 step 0.05&lt;br&gt;Prim-C&amp;amp;W 3×42 Adam lr 0.5&lt;br&gt;Prim-PGD selected (Exp B)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#808080;strokeWidth=1;dashed=1;dashPattern=2 3;spacingLeft=6;" vertex="1" parent="g2"><mxGeometry x="460" y="50" width="270" height="130" as="geometry" /></mxCell><mxCell id="d_inc" value="&lt;b&gt;Incumbent update&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;realized flows only&lt;br&gt;success replaces failure&lt;br&gt;successes min p/p&lt;sup&gt;hi&lt;/sup&gt; + D/D&lt;sup&gt;hi&lt;/sup&gt;&lt;br&gt;ties, failures → lower margin&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="g2"><mxGeometry x="460" y="210" width="335" height="150" as="geometry" /></mxCell><mxCell id="d_enum" value="&lt;b&gt;Exact pad enumeration&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;p = 1 … ⌊p&lt;sup&gt;hi&lt;/sup&gt;⌋, D = 0&lt;br&gt;stop at first success&lt;br&gt;pad-allowed rows only&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="g2"><mxGeometry x="460" y="400" width="270" height="110" as="geometry" /></mxCell><mxCell id="d_gate" value="&lt;b&gt;validator_v2 gate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;V = hybrid_valid(x′ | x)&lt;br&gt;SCHEMA ∧ EXTRACTOR ∧&lt;br&gt;PROTOCOL ∧ MINED&lt;br&gt;incl. PROTO_0080&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#d6e4f5;strokeColor=#1f5fa8;strokeWidth=2.5;" vertex="1" parent="g2"><mxGeometry x="460" y="595" width="270" height="130" as="geometry" /></mxCell><mxCell id="d_succ" value="&lt;b&gt;hit ∧ V&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=20;fontColor=#000000;gradientColor=none;" vertex="1" parent="g2"><mxGeometry x="495" y="830" width="200" height="120" as="geometry" /></mxCell><mxCell id="d_final" value="&lt;b&gt;Final x′ + per-row .npz&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;stops if &amp;lt; 2 of B=256 left&lt;br&gt;controls, box, costs, evals&lt;br&gt;success/invalid/exhausted/&lt;br&gt;no_headroom; source, codes&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="g3"><mxGeometry x="15" y="210" width="295" height="150" as="geometry" /></mxCell><mxCell id="d_integ" value="&lt;b&gt;Runner integrity checks&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;aborts on non-finite value&lt;br&gt;change outside 23 features&lt;br&gt;padding without capability&lt;br&gt;empty fwd packet filled&lt;br&gt;records only, per row&lt;br&gt;incumbent_final_mismatch&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="g3"><mxGeometry x="15" y="390" width="295" height="180" as="geometry" /></mxCell><mxCell id="d_gates" value="&lt;b&gt;evaluate_cell gates&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;raw success, validator_pass&lt;br&gt;realizable&lt;br&gt;primitive_feasible&lt;br&gt;semantic_pass + class rule&lt;br&gt;DoS/DDoS pkts/s ≥ train p05&lt;br&gt;Recon, BruteForce&lt;br&gt;NOT_TESTABLE&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="g3"><mxGeometry x="15" y="610" width="295" height="200" as="geometry" /></mxCell><mxCell id="d_metrics" value="&lt;b&gt;Nested ASR, N = 800&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;ASR_raw ⊇ ASR_valid ⊇&lt;br&gt;ASR_prim-feasible ⊇ SP-ASR&lt;br&gt;analyzer aborts on mismatch&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="g3"><mxGeometry x="15" y="860" width="295" height="120" as="