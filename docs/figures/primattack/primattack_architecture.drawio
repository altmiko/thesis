belBackgroundColor=#ffffff;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="pa_1" source="a_val" target="a7"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="pb" name="(b) RealizedSearch, per flow"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1000" pageHeight="820" math="0" shadow="0"><root><mxCell id="pb_0" /><mxCell id="pb_1" parent="pb_0" /><mxCell id="frame" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="pb_1"><mxGeometry x="0" y="0" width="1000" height="820" as="geometry" /></mxCell><mxCell id="pb_title" value="(b) RealizedSearch, per flow" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#000000;" vertex="1" parent="pb_1"><mxGeometry x="15" y="14" width="600" height="32" as="geometry" /></mxCell><mxCell id="b2" value="&lt;b&gt;Gradient-only surrogate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;φ with quantize=False&lt;br&gt;at max(q, 1e-3) → ∇ margin&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#808080;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="pb_1"><mxGeometry x="15" y="60" width="265" height="120" as="geometry" /></mxCell><mxCell id="b1" value="&lt;b&gt;Optimizer step&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;controls q ∈ [0,1]³&lt;br&gt;p = q&lt;sub&gt;1&lt;/sub&gt;·p&lt;sup&gt;hi&lt;/sup&gt;, D = q&lt;sub&gt;2&lt;/sub&gt;·D&lt;sup&gt;hi&lt;/sup&gt;&lt;br&gt;s = q&lt;sub&gt;3&lt;/sub&gt;·s&lt;sup&gt;hi&lt;/sup&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="pb_1"><mxGeometry x="15" y="250" width="265" height="120" as="geometry" /></mxCell><mxCell id="b3" value="&lt;b&gt;Integer projection&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;p → bytes, D → µs, clamp s&lt;br&gt;zero disallowed primitives&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="pb_1"><mxGeometry x="367" y="250" width="265" height="120" as="geometry" /></mxCell><mxCell id="b4" value="&lt;b&gt;Canonical transform φ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;quantize=True → x′&lt;br&gt;recomputes 23 features&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#d6e4f5;strokeColor=#1f5fa8;strokeWidth=2.5;" vertex="1" parent="pb_1"><mxGeometry x="720" y="250" width="265" height="120" as="geometry" /></mxCell><mxCell id="b7" value="&lt;b&gt;Incumbent update&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;hit replaces non-hit&lt;br&gt;hits min p/p&lt;sup&gt;hi&lt;/sup&gt; + D/D&lt;sup&gt;hi&lt;/sup&gt;&lt;br&gt;non-hits min margin&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="pb_1"><mxGeometry x="15" y="470" width="265" height="120" as="geometry" /></mxCell><mxCell id="b5" value="&lt;b&gt;Victim prediction f(x′)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;logit margin&lt;br&gt;hit = objective met&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="pb_1"><mxGeometry x="720" y="470" width="265" height="120" as="geometry" /></mxCell><mxCell id="b8" value="&lt;b&gt;Final adversarial x′&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;to evaluate_cell&lt;br&gt;post hoc validator_v2&lt;br&gt;hybrid_valid(x′ | x)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontFamily=Helvetica;fontColor=#000000;gradientColor=none;shadow=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="pb_1"><mxGeometry x="15" y="670" width="265" height="120" as="geometry" /></mxCell><mxCell id="eb_b1_b2" value="q" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;endFill=1;strokeColor=#808080;strokeWidth=1.5;fontSize=18;fontColor=#000000;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="pb_1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"><mxPoint x="-15" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="eb_b2_b1" value="∇ margin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;endFill=1;strokeColor=#808080;strokeWidth=1.5;fontSize=18;fontColor=#000000;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="pb_1" source="b2" target="b1"><mxGeometry relative="1" as="geometry"><mxPoint x="47" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="eb_b1_b3" value="p, D, s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;